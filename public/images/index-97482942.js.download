  display: flex;
  flex-direction: column;
  .csit {
    color: var(--default-white, #fff);
    font-family: Playfair Display;
    font-size: 45px;
    font-style: normal;
    font-weight: 600;
    line-height: 40%;
    text-transform: capitalize;
  }
  @media (max-width: 480px) {
    .csit {
      font-size: 29px;
      line-height: 120%;
    }
  }
  @media (min-width: 481px) and (max-width: 730px) {
    .csit {
      font-size: 46px;
      line-height: 100%;
    }
  }
