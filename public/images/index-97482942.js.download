  width: 100%;
  height: 90px;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  position: relative;
  border-bottom: 2px solid #8fb8e6;
  background-color: white;
  z-index: 999999999999;

  .pagelist {
    font-size: 16px;
    display: flex;
    gap: 40px;
  }

  .pagelist-mobile {
    height: 0;
    width: 0;
  }

  @media (min-width: 320px) and (max-width: 480px) {
    justify-content: space-between;
    transition: all 0.5s ease;

    .pagelist {
      display: none;
    }

    .pagelist-mobile {
      display: flex;
      align-items: center;
      flex-direction: column;
      position: absolute;
      top: 100%;
      gap: 40px;
      height: fit-content;
      width: 100%;
      background-color: #f3edf7;
      padding-top: 30px;
      padding-bottom: 30px;
      font-size: 16px;
      z-index: 100;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    justify-content: space-between;

    .pagelist {
      display: none;
    }

    .pagelist-mobile {
      display: flex;
      align-items: center;
      flex-direction: column;
      position: absolute;
      top: 100%;
      gap: 40px;
      height: fit-content;
      width: 100%;
      background-color: #f3edf7;
      transition: all 0.5s ease;
      padding-top: 30px;
      padding-bottom: 30px;
      font-size: 16px;
      z-index: 100;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .pagelist {
      gap: 10px;
      font-size: 15px;
    }
  }
  @media (min-width: 1025px) and (max-width: 1308px) {
    .pagelist {
      gap: 20px;
    }
  }
`,RI=P.img`
  display: none;

  @media (min-width: 320px) and (max-width: 480px) {
    display: block;
    position: absolute;
    right: 10px;
  }

  @media (min-width: 481px) and (max-width: 768px) {
    display: block;
    position: absolute;
    right: 20px;
  }
`,zI=P.img`
  width: 25%;

  @media (min-width: 320px) and (max-width: 480px) {
    height: 55px;
    width: 250px;
    position: absolute;
    left: 10px;
    display: block;
  }

  @media (min-width: 481px) and (max-width: 768px) {
    height: 60px;
    width: 210px;
    position: absolute;
    left: 20px;
    display: block;
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    height: 60px;
  }
  @media (min-width: 1025px) and (max-width: 1308px) {
    height: 65px;
  }
  @media (min-width: 1308px) {
    width: 20%;
    max-width: 300px;
    min-width: 200px;
    height: auto;
  }
`,et=P.div`
  display: flex;
  align-items: center;
  gap: 5px;
  text-decoration: none;
  color: ${t=>t.$Color||"black"};
  &:hover {
    cursor: pointer;
  }

  @media (min-width: 320px) and (max-width: 480px) {
    flex-direction: column;
    width: 100%;
  }

  @media (min-width: 481px) and (max-width: 768px) {
    flex-direction: column;
    width: 100%;
  }
`,DI=P.button`
  height: ${t=>t.$height||"50px"};
  width: ${t=>t.$width||"fit-content"};
  border-radius: 200px;
  background-color: ${t=>t.$backgroundColor};
  color: ${t=>t.$textColor||"white"};
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 5px;
  padding: 5px 15px;
  font-family: "Roboto", sans-serif;

  &:hover {
    cursor: pointer;
  }

  @media (min-width: 320px) and (max-width: 480px) {
    display: none;
  }

  @media (min-width: 481px) and (max-width: 768px) {
    display: none;
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    height: ${t=>t.$height||"50px"};
    width: ${t=>t.$width||"fit-content"};
    font-size: 15px;
  }
`,LI=gc`
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
`,$I=P.div`
  animation: ${LI} 1s ease-in infinite alternate;
`,dt=P(Fy)`
  text-decoration: none;
  color: black;
  &.active {
    font-weight: bold;
    color: #9f162e;
  }
`,Zp=P.div`
  position: absolute;
  top: ${t=>t.$top||"80%"};
  left: ${t=>t.$left};
  width: ${t=>t.$width||"170px"};
  height: fit-content;
  background-color: #f3edf7;
  z-index: 1;
  display: flex;
  flex-direction: column;
  border-bottom: 3px solid #9f162e;

  .sub-heading {
    display: flex;
    align-items: space-between;
    line-height: 50px;
    transition: all 0.3s ease;
    gap: 70px;
    padding-left: 15px;

    &:hover {
      background-color: #9f162e;
      color: white;
    }
  }

  @media (min-width: 320px) and (max-width: 480px) {
    display: block;
    position: relative;
    top: 100%;
    border: none;
    width: 100%;
    box-shadow: 2px 2px 12px 1px rgba(0, 0, 255, 0.2);

    .sub-heading {
      display: flex;
      align-items: space-between;
      transition: all 0.3s ease;
      gap: 0px;
      padding: 0;
      align-items: center;
      &:hover {
        background-color: transparent;
        color: black;
      }
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    display: block;
    position: relative;
    top: 100%;
    border: none;
    width: 100%;
    box-shadow: 2px 2px 12px 1px rgba(0, 0, 255, 0.2);

    .sub-heading {
      display: flex;
      align-items: space-between;
      transition: all 0.3s ease;
      gap: 0px;
      padding: 0;
      align-items: center;
      &:hover {
        background-color: transparent;
        color: black;
      }
    }
  }
