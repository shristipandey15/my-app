`,j$=()=>p.jsxs("div",{children:[p.jsxs(tp,{children:[p.jsx(np,{children:p.jsx("p",{className:"csit",children:"BIT(PROPOSED)"})}),p.jsxs(Rc,{$backgroundColor:"#9F162E",children:[p.jsx("img",{src:jf,alt:""}),p.jsx("span",{children:"Enroll Now"})]})]}),p.jsxs(xe,{style:{marginTop:"3rem"},children:[p.jsxs(Ma,{children:[p.jsx(Oa,{children:"INTRODUCTION "}),p.jsx("span",{children:p.jsx("img",{src:It,alt:"xm "})})]}),p.jsxs(Li,{children:["About ",p.jsx("span",{style:{textTransform:"uppercase"},children:"BIT"})]}),p.jsx(Gd,{children:"The Bachelors in Information Technology (BIT) program offered by Tribhuvan University is designed based on the curriculum practiced in accredited international universities. The program is open to students who have completed twelve years of schooling in any stream or its equivalent from a recognized board. In addition to the fundamenta l and core Information Technology courses, the BIT program provides various elective courses to fulfill the undergraduate academic requirements and cater to the demand for new technology development and implementation. During the four-year BIT program, students are required to take courses in Information Technology foundations and core subjects, as well as subjects in mathematics, statistics, management, economics, sociology, psychology, research methodology, technical writing, and elective courses. This comprehensive curriculum aims to prepare students for a successful career in the field of Information Technology."}),p.jsxs(M$,{children:[" ",p.jsx("span",{className:"note",children:"Note:"})," For further information please visit college administration."]})]})]}),I$="/assets/ITT-42abfa6c.pdf",R$="/assets/CP-e0f1c39f.pdf",z$="/assets/DL-1142e2ea.pdf",D$="/assets/Mathmatics-cfc6a932.pdf",L$="/assets/Physics-bccae0e1.pdf",$$="/assets/BSc CSIT First Semester 2074-d15dd2cf.pdf",N$="/assets/BSc CSIT First Semester 2071-8e8236c9.pdf",B$="/assets/DiscreteStructures-84263ee3.pdf",F$="/assets/OOP-4e598d35.pdf",U$="/asset